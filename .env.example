# Supabase (Paramètres du projet > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=...                # publique : utilisée aussi par le navigateur
SUPABASE_SERVICE_ROLE_KEY=...        # SECRÈTE : uniquement côté serveur (Vercel)
# Chiffrement des identifiants courtiers (32 octets en base64) : openssl rand -base64 32
ENCRYPTION_KEY=...
# Tâches planifiées Vercel (en-tête Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=...
# Macro : EIA (https://www.eia.gov/opendata/register.php)
EIA_API_KEY=...
# Signature des versions validées (HMAC-SHA256, 32 caractères minimum) : openssl rand -hex 32
SIGNING_KEY=...
# IA connectée
ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=claude-haiku-5-5
# SocialTraderTools (adresse et jeton de l'API de votre compte)
STT_API_BASE=
STT_API_TOKEN=
# Interactive Brokers Flex Web Service (hôte, modifiable si IBKR le change)
IBKR_FLEX_BASE=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
# Origine autorisée en CORS si le front est hébergé ailleurs que le backend (ex. https://mon-front.app)
ALLOWED_ORIGIN=

# v8.3 : cours du soir (facultatifs, offres gratuites) et identification auprès de la SEC
TIINGO_API_KEY=
EODHD_API_KEY=
SEC_USER_AGENT=OVERRIDE.DESK votre-email@exemple.com
